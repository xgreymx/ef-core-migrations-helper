<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.2.2</VersionPrefix>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>efm</ToolCommandName>
    <PackageId>EfCoreMigrationsHelper.Tool</PackageId>
    <Authors>xgreymx</Authors>
    <Title>EF Core Migrations Helper</Title>
    <Description>Cross-platform EF Core migration helper with short commands and persisted setup profiles.</Description>
    <PackageTags>ef-core;entity-framework;dotnet-tool;migrations</PackageTags>
    <PackageProjectUrl>https://github.com/xgreymx/ef-core-migrations-helper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xgreymx/ef-core-migrations-helper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Fix spinner/output line breaks, preserve configured nested migrations output directories on first add, and expand Smart App Control troubleshooting guidance and reset emphasis.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>EfCoreMigrationsHelper.Tool.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
